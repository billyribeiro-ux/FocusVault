{
  "$schema": "https://turbo.build/schema.json",
  "tasks": {
    "dev": {
      "cache": false,
      "persistent": true
    },
    "build": {
      "outputs": ["build/**", ".svelte-kit/**", ".output/**"],
      "dependsOn": ["^build"]
    },
    "lint": {},
    "check": {
      "dependsOn": ["^build"]
    }
  }
}
