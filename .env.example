# FocusVault Environment Configuration

# Database (Postgres for web deployment)
DATABASE_URL=postgres://focusvault:focusvault@localhost:5432/focusvault

# Server
HOST=127.0.0.1
PORT=3000

# Auth — REQUIRED in production. Generate with: openssl rand -hex 32
JWT_SECRET=change-me-in-production

# Database backend: "sqlite" or "postgres"
DB_BACKEND=postgres

# Frontend (for CORS in dev)
FRONTEND_URL=http://localhost:5173

# Logging
RUST_LOG=focusvault_server=debug,tower_http=debug
