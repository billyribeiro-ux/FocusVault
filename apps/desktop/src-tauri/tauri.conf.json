{
  "$schema": "https://raw.githubusercontent.com/nicegui/nicegui/refs/heads/main/nicegui/templates/tauri_conf_v2.json",
  "productName": "FocusVault",
  "version": "0.1.0",
  "identifier": "com.focusvault.app",
  "build": {
    "frontendDist": "../../web/build",
    "devUrl": "http://localhost:5173",
    "beforeBuildCommand": "cd ../../web && pnpm build",
    "beforeDevCommand": "cd ../../web && pnpm dev"
  },
  "app": {
    "title": "FocusVault",
    "windows": [
      {
        "title": "FocusVault",
        "width": 1100,
        "height": 750,
        "minWidth": 800,
        "minHeight": 600,
        "center": true,
        "resizable": true
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "shell": {
      "open": true
    }
  }
}
